%%%% Names and acronyms for the Intelligent Agents 2026/2027 report template
%%%% by Andrea Omicini <mailto:andrea.omicini@unibo.it>
%%%%
%% Names with a long form are acro acronyms; names that are pure typography are
%% plain \newcommands further down. Found via \input@path, set in report.tex, so
%% no \ProvidesPackage line here. See README.md.
%%
%% Use acro's own commands: \ac{id} expands the long form once, on first use, and
%% prints the short form every time after; \acs \acl \acf \acp \Ac force a form,
%% and the starred \acs*{id} prints the short form in a heading without spending
%% the first use. Never wrap them in an \mas-style macro of your own.
%%
\RequirePackage{acro}
%%
\DeclareAcronym{mas}{short = MAS, long = multi-agent system}
%% pdfstring: the plain-text twin hyperref needs whenever a short form carries
%% markup. Required, not optional -- without it the PDF bookmarks are mangled.
\DeclareAcronym{ai}{%
	short = {AI},
	long  = {artificial intelligence},
	pdfstring = AI}
\DeclareAcronym{bdi}{%
	short = {\textsc{BDI}},
	long  = {\textsc{B}elief, \textsc{D}esire, \textsc{I}ntention},
	pdfstring = BDI}
\DeclareAcronym{acl}{%
	short = \ensuremath{\mathcal{ACL}},
	long  = \ensuremath{\mathcal{A}}gent \ensuremath{\mathcal{C}}ommunication
	        \ensuremath{\mathcal{L}}anguage,
	pdfstring = ACL}
\DeclareAcronym{fipa}{%
	short = {FIPA},
	long  = {F}oundation for {I}ntelligent {P}hysical {A}gents,
	pdfstring = FIPA}
%% A&A: the meta-model behind an environment modelled as a first-class
%% abstraction. No ampersand survives a pdfstring, in any escaping: "AeA" it is.
\DeclareAcronym{aea}{%
	short = {\textsc{A\&A}},
	long  = {\textsc{A}gents \textsc{\&} \textsc{A}rtefacts},
	pdfstring = AeA}
\DeclareAcronym{jade}{%
	short = {\textsc{Jade}},
	long  = {\textsc{J}ava \textsc{A}gent \textsc{DE}velopment Framework},
	pdfstring = Jade}
\DeclareAcronym{cartago}{%
	short = {\textsf{CArtAgO}},
	long  = {\textsf{C}artesian \textsf{A}rtifacts for \textsf{A}gents
	         \textsf{O}riented programming},
	pdfstring = CArtAgO}
\DeclareAcronym{lm}{%
	short = {LM},
	long  = {language model},
	pdfstring = LM}
\DeclareAcronym{llm}{%
	short = {LLM},
	long  = {large language model},
	pdfstring = LLM}
\DeclareAcronym{nesy}{%
	short = {NeSy},
	long  = {neurosymbolic},
	pdfstring = NeSy}
%% Logic and logic programming.
\DeclareAcronym{fol}{%
	short = {FOL},
	long  = {first-order logic},
	pdfstring = FOL}
\DeclareAcronym{cnf}{%
	short = {CNF},
	long  = {clausal normal form},
	pdfstring = CNF}
\DeclareAcronym{mgu}{%
	short = {MGU},
	long  = {most general unifier},
	pdfstring = MGU}
%% The long form is Brass's gloss, the only attested one that keeps the
%% selection function.
\DeclareAcronym{sld}{%
	short = {SLD},
	long  = {Linear resolution for Definite clauses with Selection function},
	pdfstring = SLD}
%% A proper name, so the long form keeps its capitals.
\DeclareAcronym{lpaas}{%
	short = {LPaaS},
	long  = {Logic Programming as a Service},
	pdfstring = LPaaS}
%%
%% ids: mas  ai  bdi  acl  fipa  aea  jade  cartago  lm  llm  nesy
%%      fol  cnf  mgu  sld  lpaas
%%
