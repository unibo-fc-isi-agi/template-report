%% Loads the packages the template needs and the course identity. Student-facing:
%% keep the surface small. Found via \input@path, set in report.tex. See README.md.
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[british]{babel}
\usepackage{graphicx}
\usepackage{natbib}
\usepackage{url}
\usepackage{comment}
\usepackage{code-listings}
\usepackage{course}
\usepackage{names}
\usepackage{hyperref}
\usepackage{cleveref} % must stay last
% cleveref does not know the listings float type
\crefname{lstlisting}{listing}{listings}
\Crefname{lstlisting}{Listing}{Listings}
% figures live in img/
\graphicspath{{img/}}
% a mail address, typeset and linked
\newcommand{\emailaddr}[1]{\href{mailto:#1}{\texttt{#1}}}
% instructions to the student: typeset as read, so verbatim inside is safe
\newenvironment{guidance}{\begingroup\small\itshape}{\par\endgroup}
% ... and dropped wholesale by comment's scanner, which discards without a file
\newcommand{\templateguidanceoff}{%
  \let\guidance\undefined\let\endguidance\undefined
  \excludecomment{guidance}}
