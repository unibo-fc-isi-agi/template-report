%%%% Style for the Intelligent Agents 2026/2027 report template
%%%% by Andrea Omicini <mailto:andrea.omicini@unibo.it>
%%%% after pikalab-unibo/report-template and unibo-fc-isi-ds/template-final-report
%%%%
%% Loads the packages the template needs and the course identity. Student-facing:
%% keep the surface small. Found via \input@path, set in report.tex. See README.md.
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
% Computer Modern has no italic small caps, and sty/names.sty puts small caps
% (\ac{bdi}, \ac{aea}, \ac{jade}) inside the italic guidance boxes. Say out loud
% which shape stands in, so the substitution happens silently instead of warning
% four times a build.
\DeclareFontShape{T1}{cmr}{m}{scit}{<->ssub*cmr/m/scsl}{}
\DeclareFontShape{T1}{cmr}{bx}{scit}{<->ssub*cmr/bx/scsl}{}
\usepackage[british]{babel}
\usepackage{graphicx}
\usepackage{url}
% No natbib. It wants a .bbl whose labels it can split into author and year;
% apalike writes "[Mascardi and Omicini, 2026]", which it cannot, and against a
% numerical style such as plain it stops the build outright on \citep or \citet
% -- "Bibliography not compatible with author-year citations". Nothing here needs
% it: \cite is a LaTeX built-in, and apalike already prints author and year. For
% \citep and \citet, load natbib and switch the style to plainnat -- both, never
% one.
\usepackage{comment}
\usepackage{code-listings}
\usepackage{course}
\usepackage{names}
\usepackage{hyperref}
\usepackage{cleveref} % must stay last
% cleveref does not know the listings float type
\crefname{lstlisting}{listing}{listings}
\Crefname{lstlisting}{Listing}{Listings}
% figures live in img/
\graphicspath{{img/}}
% a mail address, typeset and linked
\newcommand{\emailaddr}[1]{\href{mailto:#1}{\texttt{#1}}}
% instructions to the student: typeset as read, so verbatim inside is safe
\newenvironment{guidance}{\begingroup\small\itshape}{\par\endgroup}
% ... and dropped wholesale by comment's scanner, which discards without a file
\newcommand{\templateguidanceoff}{%
  \let\guidance\undefined\let\endguidance\undefined
  \excludecomment{guidance}}
